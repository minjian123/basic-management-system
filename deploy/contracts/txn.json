    "/api/v1/txn/global/{global_txn_id}/commit": {
      "post": {
        "description": "请求提交（TM 核验全部分支 `prepared` 后落决定点并逐分支提交）。\n\nArgs:\n    global_txn_id: 全局事务标识。\n    uow: 请求级工作单元。\n    token: 服务身份（占位：TM 不校验发起方一致性，由服务身份通道保证）。\n    request: 请求对象（取分支驱动）。\n\nReturns:\n    ApiResponse: 统一响应，data 为全局事务视图。",
        "operationId": "commit_global_txn_api_v1_txn_global__global_txn_id__commit_post",
        "parameters": [
          {
            "in": "path",
            "name": "global_txn_id",
            "required": true,
            "schema": {
              "title": "Global Txn Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
