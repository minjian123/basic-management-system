{
  "components": {
    "schemas": {
      "ApiResponse": {},
      "ChatMessageInput": {
        "description": "流式请求中的单条消息（路由内转 `bms_core.llm.base.ChatMessage`）。",
        "properties": {
          "content": {
            "description": "消息内容",
            "title": "Content",
            "type": "string"
          },
          "role": {
            "default": "user",
            "description": "角色（user / assistant / system）",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "ChatMessageInput",
        "type": "object"
      },
      "ChatStopRequest": {
        "description": "中断在途流请求。",
        "properties": {
          "stream_id": {
            "description": "流标识",
            "title": "Stream Id",
            "type": "string"
          }
        },
        "required": [
          "stream_id"
        ],
        "title": "ChatStopRequest",
        "type": "object"
      },
      "ChatStreamRequest": {
        "description": "发起流式对话请求。",
        "properties": {
          "messages": {
            "description": "多轮对话消息",
            "items": {
              "$ref": "#/components/schemas/ChatMessageInput"
            },
            "title": "Messages",
            "type": "array"
          },
          "module": {
            "default": "ask",
            "description": "模式（ask / report / approval / doc_qa）",
            "title": "Module",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "会话标识；缺省为新会话",
            "title": "Session Id"
          }
        },
        "title": "ChatStreamRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
