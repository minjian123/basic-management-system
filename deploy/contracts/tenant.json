    "/api/v1/tenants/switch": {
      "post": {
        "description": "切换到目标租户（可按幂等键复用首次结果）。\n\nArgs:\n    service: 租户自助基座。\n    idempotency: 幂等基座（首次结果复用）。\n    tenant: 解析链租户上下文（幂等键作用域位）。\n    req: 切换请求。\n    idempotency_key: 幂等键请求头（可选）。\n\nReturns:\n    ApiResponse: 统一响应，data 为切换结果（`TenantSwitchResponse`）。",
        "operationId": "switch_tenant_api_v1_tenants_switch_post",
        "parameters": [
          {
            "description": "幂等键（可选；重复切换复用首次结果）",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "幂等键（可选；重复切换复用首次结果）",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TenantSwitchRequest"
