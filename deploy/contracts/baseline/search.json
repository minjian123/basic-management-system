  "paths": {
    "/": {
      "get": {
        "description": "应用信息。\n\nReturns:\n    ApiResponse: {code, message, data:{name, version}}。",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/api/v1/search/files": {
      "get": {
        "description": "文件内容检索（返回文件 ID 与上下文高亮）。\n\nArgs:\n    service: 文件内容检索契约。\n    q: 检索关键词。\n    file_type: 文件类型过滤。\n    page: 页码。\n    size: 每页条数。\n\nReturns:\n    ApiResponse: 统一响应，data 为文件命中（含降级字段）。",
        "operationId": "file_content_search_api_v1_search_files_get",
        "parameters": [
          {
            "description": "检索关键词",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "检索关键词",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "description": "文件类型过滤",
            "in": "query",
            "name": "file_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "文件类型过滤",
              "title": "File Type"
            }
          },
          {
            "description": "页码（从 1 起，限深 ≤ 100）",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "页码（从 1 起，限深 ≤ 100）",
              "maximum": 100,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "每页条数",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "每页条数",
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "无权限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "File Content Search",
        "tags": [
          "search"
        ]
      }
    },
    "/api/v1/search/global": {
      "get": {
        "description": "多域聚合检索（按域分组 + 高亮）。\n\nArgs:\n    service: 多域聚合检索契约。\n    q: 检索关键词。\n    types: 限定域。\n    page: 页码。\n    size: 每页条数。\n\nReturns:\n    ApiResponse: 统一响应，data 为多域分组结果（含降级字段）。",
        "operationId": "global_search_api_v1_search_global_get",
        "parameters": [
          {
            "description": "检索关键词",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "检索关键词",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "description": "限定域（多值，缺省 = 全部可检索域）",
            "in": "query",
            "name": "types",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "限定域（多值，缺省 = 全部可检索域）",
              "title": "Types"
            }
          },
          {
            "description": "页码（从 1 起，限深 ≤ 100）",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "页码（从 1 起，限深 ≤ 100）",
              "maximum": 100,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "每页条数",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "每页条数",
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "无权限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "Global Search",
        "tags": [
          "search"
        ]
      }
    },
    "/api/v1/search/logs": {
      "get": {
        "description": "审计日志检索（时间范围必填，单次 ≤ 31 天）。\n\nArgs:\n    service: 审计日志检索契约。\n    q: 检索关键词。\n    start_time: 起始时间。\n    end_time: 结束时间。\n    log_type: 日志类型过滤。\n    page: 页码。\n    size: 每页条数。\n\nReturns:\n    ApiResponse: 统一响应，data 为审计日志命中（含降级字段）。",
        "operationId": "audit_search_api_v1_search_logs_get",
        "parameters": [
          {
            "description": "检索关键词",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "检索关键词",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "description": "起始时间（必填）",
            "in": "query",
            "name": "start_time",
            "required": true,
            "schema": {
              "description": "起始时间（必填）",
              "format": "date-time",
              "title": "Start Time",
              "type": "string"
            }
          },
          {
            "description": "结束时间（必填）",
            "in": "query",
            "name": "end_time",
            "required": true,
            "schema": {
              "description": "结束时间（必填）",
              "format": "date-time",
              "title": "End Time",
              "type": "string"
            }
          },
          {
            "description": "日志类型过滤（operation / login / open / data_audit）",
            "in": "query",
            "name": "log_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "日志类型过滤（operation / login / open / data_audit）",
              "title": "Log Type"
            }
          },
          {
            "description": "页码（从 1 起，限深 ≤ 100）",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "页码（从 1 起，限深 ≤ 100）",
              "maximum": 100,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "每页条数",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "每页条数",
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "无权限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "Audit Search",
        "tags": [
          "search"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "存活检查端点。\n\nArgs:\n    request: 当前请求（取服务身份）。\n\nReturns:\n    dict: 服务状态与身份，固定返回 {\"status\": \"ok\", \"service\": 名, \"version\": 版}。",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/readyz": {
      "get": {
        "description": "就绪检查端点（启动完成态 + 停机摘流 + 注册表聚合）。\n\nArgs:\n    request: 当前请求（取应用启动完成态 / 停机摘流标记 / 服务身份）。\n    registry: 健康检查项注册表（依赖注入）。\n\nReturns:\n    JSONResponse: 全部就绪 200；未就绪、启动未完成或停机中 503。",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz"
      }
    }
  }
}
