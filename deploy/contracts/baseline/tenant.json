{
  "components": {
    "schemas": {
      "ApiResponse": {
        "description": "统一响应体：`code=0` 成功，非 0 业务错误码。\n\n- `data` 为业务数据（泛型）；失败时为 `null`；分页载荷复用分页契约基类。\n- 雪花 ID 在 JSON 中以字符串输出（`BaseSchema` 统一序列化口径）。",
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ApiResponse",
        "type": "object"
      },
      "ApiResponse_TenantMembershipListResponse_": {
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TenantMembershipListResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ApiResponse[TenantMembershipListResponse]",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "TenantMembershipGrantRequest": {
        "description": "建立 / 复活关系入参（全字段显式；`owner_tenant_id` 为用户归属租户）。",
        "properties": {
          "owner_tenant_id": {
            "description": "归属租户主键（用户建号 / 登录所在租户）",
            "title": "Owner Tenant Id",
            "type": "integer"
          },
          "source": {
            "description": "写入来源（super_admin / admin_create / import / sso_jit / …）",
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "target_tenant_id": {
            "description": "目标租户主键",
            "title": "Target Tenant Id",
            "type": "integer"
          },
          "user_id": {
            "description": "用户主键（org 服务 sys_user.id）",
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "owner_tenant_id",
          "user_id",
          "target_tenant_id",
          "source"
        ],
        "title": "TenantMembershipGrantRequest",
        "type": "object"
      },
      "TenantMembershipListResponse": {
        "description": "某用户当前有效可访问租户集合（内部端点统一响应）。",
        "properties": {
          "targets": {
            "description": "有效可访问目标租户（status=active）",
            "items": {
              "$ref": "#/components/schemas/TenantMembershipTarget"
            },
            "title": "Targets",
            "type": "array"
          }
        },
        "title": "TenantMembershipListResponse",
        "type": "object"
      },
      "TenantMembershipTarget": {
        "description": "可访问目标租户条目（关系 + 租户元信息）。",
        "properties": {
          "code": {
            "description": "目标租户编码",
            "title": "Code",
            "type": "string"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "目标租户子域名",
            "title": "Domain"
          },
          "name": {
            "description": "目标租户名称",
            "title": "Name",
            "type": "string"
          },
          "source": {
            "default": "",
            "description": "写入来源",
            "title": "Source",
            "type": "string"
          },
          "status": {
            "default": "active",
            "description": "关系状态（active / disabled）",
            "title": "Status",
            "type": "string"
          },
          "tenant_id": {
            "description": "目标租户主键（雪花 id）",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "code",
          "name"
        ],
        "title": "TenantMembershipTarget",
        "type": "object"
      },
      "TenantSwitchRequest": {
        "description": "切换租户请求：`{code}`。",
        "properties": {
          "code": {
            "description": "目标租户编码",
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "TenantSwitchRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "BMS 租户与配置服务",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "应用信息。\n\nReturns:\n    ApiResponse: {code, message, data:{name, version}}。",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/api/v1/tenant-registry": {
      "get": {
        "description": "取租户注册快照（按编码 / 域名 / 主键三选一）。\n\nArgs:\n    session: 平台服务库只读会话。\n    code: 租户编码。\n    domain: 子域名。\n    tenant_id: 租户主键雪花 id 字符串。\n\nReturns:\n    ApiResponse: 统一响应（data 为注册快照）。\n\nRaises:\n    ParamError: 未提供或多于一个来源（10001）。\n    TenantNotFoundError: 未知租户（404 / 80001）。\n    TenantSuspendedError: 租户已停用（403 / 80002）。",
        "operationId": "get_tenant_registry_api_v1_tenant_registry_get",
        "parameters": [
          {
            "description": "租户编码（与 domain / tenant_id 三选一）",
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "租户编码（与 domain / tenant_id 三选一）",
              "title": "Code"
            }
          },
          {
            "description": "子域名（与 code / tenant_id 三选一）",
            "in": "query",
            "name": "domain",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "子域名（与 code / tenant_id 三选一）",
              "title": "Domain"
            }
          },
          {
            "description": "租户主键雪花 id 字符串（与 code / domain 三选一）",
            "in": "query",
            "name": "tenant_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "租户主键雪花 id 字符串（与 code / domain 三选一）",
              "title": "Tenant Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "无权限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "Get Tenant Registry",
        "tags": [
          "tenant"
        ]
      }
    },
    "/api/v1/tenant-registry/active-single": {
      "get": {
        "description": "取唯一启用租户注册快照（免登录链路兜底；不返回租户清单）。\n\n恰 1 个启用租户（`status == active` 且未软删）→ 注册快照；0 个 → `80001` / 404；\n≥ 2 个 → `80004` / 409（`MultipleActiveTenantsError`）。\n\nArgs:\n    session: 平台服务库只读会话。\n\nReturns:\n    ApiResponse: 统一响应（data 为注册快照）。\n\nRaises:\n    TenantNotFoundError: 无启用租户（404 / 80001）。\n    MultipleActiveTenantsError: 多启用租户（409 / 80004）。",
        "operationId": "get_single_active_tenant_api_v1_tenant_registry_active_single_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "无权限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "Get Single Active Tenant",
        "tags": [
          "tenant"
        ]
      }
    },
    "/api/v1/tenant/internal/memberships": {
      "delete": {
        "description": "回收关系（置 `disabled`，幂等；省略目标租户则回收该用户全部）。\n\nArgs:\n    service: 关系服务。\n    owner_tenant_id: 归属租户主键。\n    user_id: 用户主键。\n    target_tenant_id: 目标租户主键（省略＝回收全部）。\n\nReturns:\n    ApiResponse: 统一响应，data 为操作后该用户有效目标集合。",
        "operationId": "revoke_membership_api_v1_tenant_internal_memberships_delete",
        "parameters": [
          {
            "description": "归属租户主键（用户建号 / 登录所在租户）",
            "in": "query",
            "name": "owner_tenant_id",
            "required": true,
            "schema": {
              "description": "归属租户主键（用户建号 / 登录所在租户）",
              "exclusiveMinimum": 0,
              "title": "Owner Tenant Id",
              "type": "integer"
            }
          },
          {
            "description": "用户主键（org 服务 sys_user.id）",
            "in": "query",
            "name": "user_id",
            "required": true,
            "schema": {
              "description": "用户主键（org 服务 sys_user.id）",
              "exclusiveMinimum": 0,
              "title": "User Id",
              "type": "integer"
            }
          },
          {
            "description": "目标租户主键（省略＝回收该用户全部）",
            "in": "query",
            "name": "target_tenant_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "目标租户主键（省略＝回收该用户全部）",
              "title": "Target Tenant Id"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": false,
