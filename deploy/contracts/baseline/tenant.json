    "/api/v1/tenants/brand": {
      "get": {
        "description": "取品牌信息（登录前可用；缺省当前租户）。\n\nArgs:\n    service: 租户自助基座。\n    code: 租户编码（可选）。\n\nReturns:\n    ApiResponse: 统一响应，data 为品牌信息（`TenantBrandResponse`）。",
        "operationId": "tenant_brand_api_v1_tenants_brand_get",
        "parameters": [
          {
            "description": "租户编码（缺省当前租户）",
            "in": "query",
