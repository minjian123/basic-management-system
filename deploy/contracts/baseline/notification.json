    "/api/v1/notifications": {
      "get": {
        "description": "列当前用户通知（筛选 + 分页）。\n\nArgs:\n    center: 通知中心。\n    filter: 筛选契约。\n    page: 分页契约。\n\nReturns:\n    ApiResponse: 统一响应，data 为分页通知。",
        "operationId": "list_notifications_api_v1_notifications_get",
        "parameters": [
          {
            "description": "关键字（跨字段模糊，命中列由后端定义）",
            "in": "query",
            "name": "keyword",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "关键字（跨字段模糊，命中列由后端定义）",
              "title": "Keyword"
            }
          },
          {
            "description": "筛选条件 JSON（FilterSpec 数组）",
            "in": "query",
            "name": "filters",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "筛选条件 JSON（FilterSpec 数组）",
              "title": "Filters"
            }
          },
          {
            "description": "页码（从 1 起）",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "页码（从 1 起）",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "每页条数（默认 20，上限 200）",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "每页条数（默认 20，上限 200）",
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          },
          {
            "description": "排序字段，逗号分隔多值（如 status,created_at）",
            "in": "query",
            "name": "order_by",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "排序字段，逗号分隔多值（如 status,created_at）",
              "title": "Order By"
            }
          },
          {
            "description": "排序方向数组，与 order_by 位置一一对应",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "排序方向数组，与 order_by 位置一一对应",
              "title": "Order"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "无权限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "List Notifications",
        "tags": [
          "notification"
        ]
      }
    },
