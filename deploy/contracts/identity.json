{
  "components": {
    "schemas": {
      "ApiResponse": {},
      "CaptchaChallengeRequest": {
        "description": "验证码出题请求。",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/CaptchaKind",
            "default": "image",
            "description": "挑战类型（image / slider）"
          },
          "scene": {
            "default": "login",
            "description": "使用场景（取值见 CAPTCHA_SCENES）",
            "title": "Scene",
            "type": "string"
          }
        },
        "title": "CaptchaChallengeRequest",
        "type": "object"
      },
      "CaptchaKind": {
        "description": "挑战类型（与前端验证码字段形态取值同源）。",
        "enum": [
          "image",
          "slider",
          "sms"
        ],
        "title": "CaptchaKind",
        "type": "string"
      },
      "CaptchaSmsRequest": {
        "description": "短信验证码发送请求。",
        "properties": {
          "phone": {
            "description": "目标手机号（格式校验随真实实现）",
            "minLength": 1,
            "title": "Phone",
            "type": "string"
          },
          "scene": {
            "default": "login",
            "description": "使用场景（取值见 CAPTCHA_SCENES）",
            "title": "Scene",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "CaptchaSmsRequest",
        "type": "object"
      },
      "CaptchaVerifyRequest": {
        "description": "验证码凭证校验请求。",
        "properties": {
          "captcha_id": {
            "description": "挑战编号",
            "minLength": 1,
            "title": "Captcha Id",
            "type": "string"
          },
          "code": {
            "default": "",
            "description": "用户输入的校验码（图形 / 短信）",
            "title": "Code",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/CaptchaKind",
            "default": "image",
            "description": "挑战类型（决定取校验码还是轨迹）"
          },
          "scene": {
            "default": "login",
            "description": "使用场景（取值见 CAPTCHA_SCENES）",
            "title": "Scene",
            "type": "string"
          },
          "trace": {
            "description": "滑块轨迹点序列（每点为 x / y / 相对起点毫秒）",
            "items": {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "title": "Trace",
            "type": "array"
          }
        },
        "required": [
          "captcha_id"
        ],
        "title": "CaptchaVerifyRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "BMS 认证与身份服务",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "应用信息。\n\nReturns:\n    ApiResponse: {code, message, data:{name, version}}。",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/api/v1/captcha/challenges": {
      "post": {
        "description": "生成验证码挑战（图形 / 滑块）。\n\nArgs:\n    captcha: 验证码基座。\n    req: 出题请求。\n\nReturns:\n    ApiResponse: 统一响应，data 为挑战（`CaptchaChallengeResponse`）。",
        "operationId": "create_challenge_api_v1_captcha_challenges_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptchaChallengeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "无权限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "Create Challenge",
        "tags": [
          "captcha"
        ]
      }
    },
