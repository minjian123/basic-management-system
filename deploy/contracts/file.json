{
  "components": {
    "schemas": {
      "ApiResponse": {
        "additionalProperties": false,
        "description": "统一响应体：`code=0` 成功，非 0 业务错误码。\n\n- `data` 为业务数据（泛型）；失败时为 `null`；分页载荷复用分页契约基类。\n- 雪花 ID 在 JSON 中以字符串输出（`BaseSchema` 统一序列化口径）。",
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ApiResponse",
        "type": "object"
      },
      "Body_upload_file_api_v1_files_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "文件内容（表单字段 file）",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_file_api_v1_files_post",
        "type": "object"
      },
      "Body_upload_part_api_v1_files_multipart__upload_id__parts__part_no__put": {
        "properties": {
          "data": {
            "contentMediaType": "application/octet-stream",
            "description": "分片内容（表单字段 data）",
            "title": "Data",
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "title": "Body_upload_part_api_v1_files_multipart__upload_id__parts__part_no__put",
        "type": "object"
      },
      "DedupRequest": {
        "additionalProperties": false,
        "description": "秒传登记请求。",
        "properties": {
          "mime": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "声明的内容类型（仅供预检）",
            "title": "Mime"
          },
          "name": {
            "description": "原始文件名（含扩展名）",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "sha256": {
            "description": "整文件 SHA256",
            "maxLength": 64,
            "minLength": 64,
            "title": "Sha256",
            "type": "string"
          },
          "size": {
            "description": "文件字节数",
            "exclusiveMinimum": 0.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "size",
          "sha256"
        ],
        "title": "DedupRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MultipartInitiateRequest": {
        "additionalProperties": false,
        "description": "分片初始化请求。",
        "properties": {
          "mime": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "声明的内容类型（仅供预检，不作真值）",
            "title": "Mime"
          },
          "name": {
            "description": "原始文件名（含扩展名）",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "sha256": {
            "description": "整文件 SHA256（64 位小写十六进制）",
            "maxLength": 64,
            "minLength": 64,
            "title": "Sha256",
            "type": "string"
          },
          "size": {
            "description": "文件字节数（须大于 0）",
            "exclusiveMinimum": 0.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "size",
          "sha256"
        ],
        "title": "MultipartInitiateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "BMS 文件服务",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "应用信息。\n\nReturns:\n    ApiResponse: {code, message, data:{name, version}}。",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/api/v1/files": {
      "get": {
        "description": "文件列表（名称 / 类型 / 上传人 / 状态 / 时间范围筛选 + 分页）。\n\nArgs:\n    uow: 工作单元。\n    storage: 对象存储。\n    multipart: 分片上传。\n    config: 系统参数。\n    client: 服务调用客户端。\n    outbox: 发件箱。\n    audit: 审计捕获器。\n    metrics: 指标。\n    page: 分页参数。\n    name: 名称关键字。\n    mime_type: 内容类型前缀。\n    uploader_id: 上传人。\n    status: 状态。\n    created_from: 创建时间下限。\n    created_to: 创建时间上限。\n\nReturns:\n    ApiResponse: 统一响应，data 为分页结果。",
        "operationId": "list_files_api_v1_files_get",
        "parameters": [
          {
            "description": "文件名关键字（模糊匹配）",
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "文件名关键字（模糊匹配）",
              "title": "Name"
            }
          },
          {
            "description": "内容类型前缀（如 image/）",
            "in": "query",
            "name": "mime_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "内容类型前缀（如 image/）",
              "title": "Mime Type"
            }
          },
          {
            "description": "上传人",
            "in": "query",
            "name": "uploader_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "上传人",
              "title": "Uploader Id"
            }
          },
          {
            "description": "状态（uploading/completed/failed/orphan）",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "状态（uploading/completed/failed/orphan）",
              "title": "Status"
            }
          },
          {
            "description": "创建时间下限（含）",
            "in": "query",
            "name": "created_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "创建时间下限（含）",
              "title": "Created From"
            }
          },
          {
            "description": "创建时间上限（含）",
            "in": "query",
            "name": "created_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "创建时间上限（含）",
              "title": "Created To"
            }
          },
          {
            "description": "页码（从 1 起）",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "页码（从 1 起）",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "每页条数（默认 20，上限 200）",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "每页条数（默认 20，上限 200）",
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          },
          {
            "description": "排序字段，逗号分隔多值（如 status,created_at）",
            "in": "query",
            "name": "order_by",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "排序字段，逗号分隔多值（如 status,created_at）",
              "title": "Order By"
            }
          },
          {
            "description": "排序方向数组，与 order_by 位置一一对应",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "排序方向数组，与 order_by 位置一一对应",
              "title": "Order"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "无权限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "List Files",
        "tags": [
          "file"
        ]
      },
      "post": {
        "description": "整包上传（≤ `file.upload.max_size`；类型白名单 + 大小 + 配额校验）。\n\nArgs:\n    uow: 工作单元。\n    storage: 对象存储。\n    multipart: 分片上传。\n    config: 系统参数。\n    client: 服务调用客户端。\n    outbox: 发件箱。\n    audit: 审计捕获器。\n    metrics: 指标。\n    file: 上传文件。\n    name: 覆盖文件名（可选）。\n\nReturns:\n    ApiResponse: 统一响应，data 为 `UploadResult`。",
        "operationId": "upload_file_api_v1_files_post",
        "parameters": [
          {
            "description": "覆盖文件名（可选，缺省取上传文件名）",
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "覆盖文件名（可选，缺省取上传文件名）",
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_api_v1_files_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "无权限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "Upload File",
        "tags": [
          "file"
        ]
      }
    },
    "/api/v1/files/dedup": {
      "post": {
        "description": "秒传登记（同租户命中既有对象即建行；未命中 data 为 null）。\n\nArgs:\n    uow: 工作单元。\n    storage: 对象存储。\n    multipart: 分片上传。\n    config: 系统参数。\n    client: 服务调用客户端。\n    outbox: 发件箱。\n    audit: 审计捕获器。\n    metrics: 指标。\n    request: 秒传请求。\n\nReturns:\n    ApiResponse: 统一响应，data 为 `DedupResult` 或 null。",
        "operationId": "dedup_api_v1_files_dedup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DedupRequest"
              }
            }
