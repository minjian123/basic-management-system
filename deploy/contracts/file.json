          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "Dedup",
        "tags": [
          "file"
        ]
      }
    },
    "/api/v1/files/internal/cleanup-orphans": {
      "post": {
        "description": "孤儿回收（服务间内部端点；由内置任务 `cleanup_orphan_parts` 触发）。\n\nArgs:\n    uow: 工作单元。\n    storage: 对象存储。\n    multipart: 分片上传。\n    config: 系统参数。\n    client: 服务调用客户端。\n    outbox: 发件箱。\n    audit: 审计捕获器。\n    metrics: 指标。\n    limit: 单批上限。\n\nReturns:\n    ApiResponse: 统一响应，data 为 `CleanupResult`。",
        "operationId": "cleanup_orphans_api_v1_files_internal_cleanup_orphans_post",
        "parameters": [
          {
            "description": "单批清理上限",
            "in": "query",
            "name": "limit",
