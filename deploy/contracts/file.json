        },
        "summary": "Cleanup Orphans",
        "tags": [
          "file-internal"
        ]
      }
    },
    "/api/v1/files/multipart": {
      "post": {
        "description": "分片上传初始化（返回会话标识 / 分片大小 / 分片总数 / 过期时间；可按幂等键复用）。\n\nArgs:\n    uow: 工作单元。\n    storage: 对象存储。\n    multipart: 分片上传。\n    config: 系统参数。\n    client: 服务调用客户端。\n    outbox: 发件箱。\n    audit: 审计捕获器。\n    metrics: 指标。\n    idempotency: 幂等存储。\n    request: 初始化请求。\n    idempotency_key: 幂等键（可选）。\n\nReturns:\n    ApiResponse: 统一响应，data 为 `MultipartInitiateResult`。",
        "operationId": "initiate_multipart_api_v1_files_multipart_post",
        "parameters": [
          {
            "description": "幂等键（可选；重复初始化复用首次会话）",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "幂等键（可选；重复初始化复用首次会话）",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MultipartInitiateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
