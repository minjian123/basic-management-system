{
  "components": {
    "schemas": {
      "ApiResponse": {},
      "ApiResponse_CredentialVerifyResult_": {},
      "ApiResponse_LoginStateResult_": {},
      "ApiResponse_UpdatePasswordResult_": {},
      "CredentialUserSummary": {},
      "CredentialVerifyRequest": {
        "description": "凭据校验请求（账号 + 密码明文；租户经服务 JWT `tenant` claim 解析）。",
        "properties": {
          "account": {
            "description": "登录账号",
            "maxLength": 64,
            "minLength": 1,
            "title": "Account",
            "type": "string"
          },
          "password": {
            "description": "口令明文",
            "maxLength": 512,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "account",
          "password"
        ],
        "title": "CredentialVerifyRequest",
        "type": "object"
      },
      "CredentialVerifyResult": {},
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginStateRequest": {
        "description": "登录态写回请求（成功清零 / 失败计数与锁定）。",
        "properties": {
          "account": {
            "description": "登录账号",
            "maxLength": 64,
            "minLength": 1,
            "title": "Account",
            "type": "string"
          },
          "failed_count": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "失败计数（失败时由登录侧传入）",
            "title": "Failed Count"
          },
          "lock_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "锁定时长（秒；>0 且失败时写 locked_until）",
            "title": "Lock Seconds"
          },
          "success": {
            "description": "本次登录是否成功",
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "account",
          "success"
        ],
        "title": "LoginStateRequest",
        "type": "object"
      },
      "LoginStateResult": {},
      "UpdatePasswordRequest": {
        "description": "密码更新请求（改密 / 找回密码 / 重哈希回写）。",
        "properties": {
          "account": {
            "description": "登录账号",
            "maxLength": 64,
            "minLength": 1,
            "title": "Account",
            "type": "string"
          },
          "keep_history": {
            "default": 5,
            "description": "保留历史密码条数",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Keep History",
            "type": "integer"
          },
          "new_password": {
            "description": "新口令明文",
            "maxLength": 512,
            "minLength": 1,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "account",
          "new_password"
        ],
        "title": "UpdatePasswordRequest",
        "type": "object"
      },
      "UpdatePasswordResult": {},
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "BMS 组织主数据服务",
    "version": "0.1.0"
  },
