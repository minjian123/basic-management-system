    "/api/v1/org/posts": {
      "get": {
        "description": "查询组织岗位（关键字 / 部门 / 含子级 / 状态 / 分页）。\n\nArgs:\n    service: 组织查询契约。\n    keyword: 关键字。\n    dept_id: 归属部门 ID。\n    include_children: 部门过滤是否含下级。\n    status: 状态过滤。\n    page: 页码。\n    size: 每页条数。\n\nReturns:\n    ApiResponse: 统一响应，data 为分页岗位。",
        "operationId": "list_org_posts_api_v1_org_posts_get",
        "parameters": [
          {
            "description": "关键字（岗位编码 / 名称）",
            "in": "query",
            "name": "keyword",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "关键字（岗位编码 / 名称）",
              "title": "Keyword"
            }
          },
          {
            "description": "归属部门 ID",
            "in": "query",
            "name": "dept_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "归属部门 ID",
              "title": "Dept Id"
            }
          },
          {
            "description": "部门过滤是否含下级",
            "in": "query",
            "name": "include_children",
            "required": false,
            "schema": {
              "default": false,
              "description": "部门过滤是否含下级",
              "title": "Include Children",
              "type": "boolean"
            }
          },
          {
            "description": "状态过滤（enabled / disabled）",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "状态过滤（enabled / disabled）",
              "title": "Status"
            }
          },
          {
            "description": "页码（从 1 起）",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "页码（从 1 起）",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "每页条数",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "每页条数",
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
