# BMS 前端 CI 基础镜像：预装 frontend / frontend-mobile node_modules（按 package-lock 哈希打标签）
# 消费方：frontend-check / frontend-build / frontend-mobile-build（复制 node_modules 后直接跑）
FROM node:22-slim

ENV npm_config_registry=https://registry.npmmirror.com \
    npm_config_legacy_peer_deps=true \
    npm_config_audit=false \
    npm_config_fund=false

COPY frontend/ /opt/ci/frontend/
COPY frontend-mobile/ /opt/ci/frontend-mobile/

RUN cd /opt/ci/frontend && npm ci \
 && cd /opt/ci/frontend-mobile && npm ci
