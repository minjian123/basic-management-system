# BMS 前端 CI 基础镜像：node22 工具链 + 固定 pnpm（依赖不再镜像预装）
# 依赖由各前端 job 内 `pnpm install --frozen-lockfile` 现装：
#   - 经 runner /cache/pnpm 缓存卷 + npmmirror 现装（内容寻址 store，命中即秒级 link）
#   - 消费方：core-check / desktop-check / desktop-build / module-check / module-build / e2e-playwright
# （本地开发依赖外置到本地依赖仓 / 维护脚本，见 scripts/tools/deps/；CI 不再预置 -> 两环境口径一致：依赖不进仓库树）
FROM node:22-slim

ENV npm_config_registry=https://registry.npmmirror.com \
    npm_config_audit=false \
    npm_config_fund=false

# 注意（13_01）：本镜像**不再**承担前端选测。选测器依赖 `bms_core`（PEP 695 泛型语法，需 Python ≥ 3.12），
# 而 node:22-slim 的 Debian python3 为 3.11 —— 实测 core-check 直接 SyntaxError。
# 需要选测的三个 job（core-check / desktop-check / module-check）改用 `ci-backend:py314`
# （同镜像已含 Python 3.14 + Node 22 + git），pnpm 在该 job 内按需安装；本镜像只服务构建类 job。

# pnpm 版本固定（与本地一致；pnpm-lock.yaml 的锁语义由该版本解析）
RUN npm install -g pnpm@11.7.0