#
# BMS 边缘 nginx：前端静态资源托管 + API 流量分流 + 安全响应头（04_03 模板化）。
#
# 分流口径：静态资源由 nginx 直接托管；API 流量（/api/）统一反代至边缘网关（APISIX，只处理 API）。
# 本文件是**模板**：由 nginx 官方镜像入口脚本 `20-envsubst-on-templates.sh` 渲染为
#   /etc/nginx/conf.d/default.conf（容器内挂载为 /etc/nginx/templates/default.conf.template）。
# 仅替换 GATEWAY_* 变量（compose 设 NGINX_ENVSUBST_FILTER=^GATEWAY_），模板内 nginx 变量（$host 等）不受影响。
#
# 说明：静态目录 deploy/gateway/static/ 目前为占位，前端构建产物接入归部署阶段（13）；
#   安全响应头统一在边缘层配置——CSP 为基线严格档（前端产物接入时按需放宽），
#   HSTS 由 GATEWAY_HSTS_HEADER 注入（dev 留空不发送、生产随 TLS 启用）。
#   口径见《架构设计 · 部署与运维》《安全开发规范》「Web 常见漏洞」节。

# WebSocket 升级（如 /socket.io）；无 Upgrade 头时置空，避免误传 Connection: upgrade
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 安全响应头（统一在边缘层配置；HSTS 按环境注入——dev 不发送）
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" always;
    ${GATEWAY_HSTS_HEADER}

    # API 流量统一反代网关（网关按服务目录路由到各服务）
    location /api/ {
        # 请求体上限（04-1-2）：与文件上传口径对齐——≤20MB（file.upload.max_size）整包直传、
        #   >20MB 走分片（单片不超过整包上限）；超限在此层先拒（413 Request Entity Too Large）。
        #   取值经 GATEWAY_MAX_BODY_SIZE 注入（缺省 32m，见 deploy/compose/gateway.yml），
        #   按环境可调（生产可下调，但不得低于整包上限 + multipart 表单开销）；APISIX 侧同值配置
        #   作纵深防御（见 deploy/gateway/config.yaml 的 nginx_config）。
        client_max_body_size ${GATEWAY_MAX_BODY_SIZE};

        proxy_pass http://apisix:9080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 70s;
    }

    # 前端静态资源（SPA 回退到 index.html）
    location / {
        try_files $uri $uri/ /index.html;
    }
}
