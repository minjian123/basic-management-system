{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "title": "BMS 容量口径（异步链路）",
  "uid": "bms-capacity",
  "tags": ["bms", "observability", "capacity"],
  "timezone": "browser",
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "服务",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(bms_request_total, service)", "refId": "BMS-Var-Service"},
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      },
      {
        "name": "route",
        "label": "路由",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(bms_request_duration_seconds_bucket, route)", "refId": "BMS-Var-Route"},
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      },
      {
        "name": "tenant",
        "label": "租户",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(bms_audit_write_total, tenant)", "refId": "BMS-Var-Tenant"},
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "主链路 P99 延迟（按路由；需求 11-1：有/无副作用差异 ≤5%）",
      "description": "同端点三档对比看压测报告；此处看运行期 P99 走势，阈值线 800ms 与 SLO 一致。",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.8}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(bms_request_duration_seconds_bucket{service=~\"$service\",route=~\"$route\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "审计链消费 P95（目标 ≤5s）",
      "description": "事件发生到审计分片落库完成的时延；端到端含 broker 传输，当前消费运行时未落地时为写入侧处理段。",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 5}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le, log_type) (rate(bms_audit_consume_lag_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{log_type}} P95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "单租户日志写入吞吐（目标 ≥500 条/秒）",
      "description": "按租户的写入速率；租户维度用 $tenant 过滤，避免高基数。",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (tenant, log_type) (rate(bms_audit_write_total{service=~\"$service\",tenant=~\"$tenant\"}[1m]))",
          "legendFormat": "{{tenant}} / {{log_type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "次月审计分片就绪（1 就绪 / 0 缺；25 日后仍为 0 即告警）",
      "description": "需求 11-1：下月分片当月 25 日前创建；跨月 0 失败。",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "bms_audit_shard_next_month_ready{service=~\"$service\"}",
          "legendFormat": "{{log_type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "发件箱积压（按库键；阈值 1 万 / 租户）",
      "description": "平台库 db_key=platform，租户库 tenant_*；阈值线 10000。",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 10000}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "bms_outbox_backlog{service=~\"$service\"}",
          "legendFormat": "{{db_key}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "死信待处置数 / 最老时长（24h 未处置即告警）",
      "description": "左轴条数、右轴秒数；两个查询共用时间轴。",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": ".*age.*"},
            "properties": [{"id": "unit", "value": "s"}]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "bms_event_dead_letter_pending{service=~\"$service\"}",
          "legendFormat": "待处置 {{source}} / {{db_key}}"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "bms_event_dead_letter_age_seconds{service=~\"$service\"}",
          "legendFormat": "最老 age {{source}} / {{db_key}}"
        }
      ]
    }
  ]
}
