{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "title": "BMS 可观测总览",
  "uid": "bms-overview",
  "tags": ["bms", "observability"],
  "timezone": "browser",
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "服务",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(bms_request_total, service)", "refId": "BMS-Var-Service"},
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      },
      {
        "name": "version",
        "label": "服务版本（Tempo）",
        "type": "query",
        "datasource": {"type": "tempo", "uid": "tempo"},
        "query": {"query": "label_values(service.version)", "refId": "BMS-Var-Version"},
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求量（按路由）",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (route) (rate(bms_request_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P95 延迟（按路由，秒）",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(bms_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{route}} p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx 错误率（按服务）",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (service) (rate(bms_request_total{status=~\"5..\",service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "依赖就绪状态",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "bms_dependency_up{service=~\"$service\"}",
          "legendFormat": "{{service}}/{{dependency}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "库数量（按类别）",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "bms_db_count{service=~\"$service\"}",
          "legendFormat": "{{service}}/{{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "日志（按服务）",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 24},
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service=~\"$service\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "traces",
      "title": "链路（Tempo；服务版本变量见上方选择器）",
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 34},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "tempo", "uid": "tempo"},
          "queryType": "traceql",
          "query": "{ resource.service.name != nil }"
        }
      ]
    }
  ]
}
