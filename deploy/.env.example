# 开发环境变量模板（复制为 .env 填入真实值，.env 不入库）

# ===== mjbk 开发服务器 =====
# IP / SSH 用户 / sudo 密码（远程关机、唤醒等工具脚本使用；IP 与账号见《本地资源》）
MJBK_IP=<mjbk-IP>
MJBK_SSH_USER=<SSH账号>
MJBK_SUDO_PASSWORD=
# 有线网卡 MAC（WOL 魔术包目标）
MJBK_WOL_MAC=B0-25-AA-27-0C-32

# ===== mjw 开发服务器（Windows，winrm 工具脚本用；IP 与账号见《本地资源》） =====
MJW_IP=<mjw-IP>
MJW_WOL_MAC=B0-25-AA-40-57-CC
MJW_WINRM_USER=minjian
MJW_WINRM_PASSWORD=

# ===== 边缘网关（deploy/compose/gateway.yml） =====
# 宿主映射端口（nginx 静态/分流入口 与 APISIX 直连调试入口）；被占用时改这里
GATEWAY_HTTP_PORT=8088
GATEWAY_APISIX_PORT=9080
# 边缘观测：prometheus 指标端点宿主端口（08 可观测性栈抓取）
GATEWAY_METRICS_PORT=9091
# 边缘限流共享 Redis（04_03；默认走 Compose DNS 服务名 redis，勿写 IP；端口 / 库为整数字面量，接口 schema 要求整数）
GATEWAY_REDIS_HOST=redis
GATEWAY_REDIS_PASSWORD=
# real-ip 可信代理网段（04_03；默认 Docker 私网段，生产按实际网段收紧）
GATEWAY_TRUSTED_CIDR=172.16.0.0/12
# 网关认证接线（07_03）：forward-auth 转调的认证服务主机（Compose DNS 服务名；非 Compose 环境可改主机/IP）
# 完整转调地址 = http://${GATEWAY_AUTH_HOST}:8000/api/v1/auth/introspect，见 deploy/gateway/apisix.yaml
GATEWAY_AUTH_HOST=identity

# ===== Keycloak（自托管 OIDC IdP；deploy/compose/keycloak.yml） =====
# 宿主映射端口（浏览器 / 后端访问入口）
KEYCLOAK_PORT=8090
# 对外基址（issuer = <基址>/realms/bms；remote 访问填 http://<mjbk-IP>:8090，须与访问入口一致）
KEYCLOAK_PUBLIC_URL=http://localhost:8090
# 引导管理员（仅首次启动创建）
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# Keycloak 元数据库（bms-postgres 内独立库 keycloak；新卷自动建库，存量实例按《Keycloak 部署使用说明》手动执行一次）
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=
# BMS 作为 OIDC 客户端的 client secret（realm 导入占位 ${KEYCLOAK_CLIENT_SECRET} 解析用；
# 须与后端 BMS_IDENTITY_PROVIDER__CLIENT_SECRET 一致）
KEYCLOAK_CLIENT_SECRET=

# 服务 JWT 自签密钥（07_02；服务间身份 `aud=service`）。JSON：kid → {algorithm, public_key, private_key}；
# 公钥可随配置下发，私钥只在本文件（gitignore）与运行时 Secret 注入，不入库 / 不入镜像 / 不落日志。
# 生成示例（RS256）：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
#                     openssl rsa -in priv.pem -pubout -out pub.pem
# 注入示例（单行 JSON，换行转义为 \n；变量留空会导致配置校验失败，未使用时请整行注释）：
# BMS_SERVICE_TOKEN__KEYS={"k1":{"algorithm":"RS256","public_key":"-----BEGIN PUBLIC KEY-----\n...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}}

# ===== 服务凭据（与 mjbk ~/deploy/.env 一致） =====

# MySQL（容器 bms-mysql）
MYSQL_ROOT_PASSWORD=

# 三库测试账号密码（`ops/test_db.py` 建号与 CI verify/db 档连接用；与 GitLab 项目
# CI/CD Variables 同名同值，均为 masked，值不入库）
MYSQL_TEST_PASSWORD=
POSTGRES_TEST_PASSWORD=
DM8_TEST_PASSWORD=

# PostgreSQL（容器 bms-postgres）
POSTGRES_PASSWORD=

# MinIO（容器 bms-minio）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# 达梦 DM8（原生安装）
DM8_SYSDBA_PASSWORD=
DM8_SYSAUDITOR_PASSWORD=

# GitLab（容器 bms-gitlab）
GITLAB_ROOT_PASSWORD=

# GitLab API（scripts/tools/defect/ 三件套读取；token 为 root 的 PAT，project 为 bms/bms 的项目 ID）
GITLAB_API_URL=http://<mjbk-IP>:8080/api/v4
GITLAB_API_TOKEN=
CI_PROJECT_ID=2

# Kiwi TCMS（容器 bms-kiwi，宿主 8060；MySQL 连接用宿主 IP 与映射端口，IP 见 MJBK_IP）
KIWI_DB_HOST=<mjbk-IP>
KIWI_DB_PORT=3306
KIWI_DB_NAME=kiwi
KIWI_DB_USER=kiwi
KIWI_DB_PASSWORD=
KIWI_SECRET_KEY=
# 管理员账号 admin 的密码（mjbk 部署后经 createsuperuser 创建）
KIWI_ADMIN_PASSWORD=

# GitHub（PAT，repo 权限）
GITHUB_PAT=

# 云备份加密口令（gpg 对称加密，备份产物上云前加密）
BACKUP_CRYPT_PASSPHRASE=
