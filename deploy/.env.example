# 开发环境变量模板（复制为 .env 填入真实值，.env 不入库）

# ===== mjbk 开发服务器 =====
# IP / SSH 用户 / sudo 密码（远程关机、唤醒等工具脚本使用）
MJBK_IP=192.168.0.107
MJBK_SSH_USER=minjian
MJBK_SUDO_PASSWORD=
# 有线网卡 MAC（WOL 魔术包目标）
MJBK_WOL_MAC=B0-25-AA-27-0C-32

# ===== 服务凭据（与 mjbk ~/deploy/.env 一致） =====

# MySQL（容器 bms-mysql）
MYSQL_ROOT_PASSWORD=

# PostgreSQL（容器 bms-postgres）
POSTGRES_PASSWORD=

# MinIO（容器 bms-minio）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# 达梦 DM8（原生安装）
DM8_SYSDBA_PASSWORD=
DM8_SYSAUDITOR_PASSWORD=

# GitLab（容器 bms-gitlab）
GITLAB_ROOT_PASSWORD=

# GitHub（PAT，repo 权限）
GITHUB_PAT=
