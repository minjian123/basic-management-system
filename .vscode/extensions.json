{
  // 打开工作区时 VS Code 会提示安装缺失的推荐扩展
  "recommendations": [
    // Vue 3 官方语言支持（Volar）：.vue 与 TS 之间跳转、类型检查、模板补全
    "Vue.volar",
    // Python：解释器管理与调试
    "ms-python.python",
    // Python：调试适配器（`launch.json` 里 type=debugpy 的后端调试项依赖它）
    "ms-python.debugpy",
    // Python：语言服务（跳转 / 补全 / 类型检查，后端跳转依赖它）
    "ms-python.vscode-pylance",
    // 前端 ESLint 与 Prettier（frontend/apps/desktop / frontend/apps/mobile + frontend/packages/*）
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode"
    // 说明：md 文档的 mermaid 预览由 VS Code 内置的 `mermaid-markdown-features` 提供
    //（1.142 起随内核发布），不再推荐安装 `bierner.markdown-mermaid`——两者会抢注同名
    // `markdown-mermaid.*` 配置键，日志持续刷「无法注册…此属性已注册」。
  ]
}
