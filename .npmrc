# npmmirror 国内源（npm 时代同款配置；pnpm 读取）
registry=https://registry.npmmirror.com

# pnpm 依赖解析口径（原 `legacy-peer-deps` 为 npm 专用、pnpm 忽略）：
#   auto-install-peers=true  —— 自动安装 peer 依赖（平滑 npm 迁移，减少手工补声明）
#   strict-peer-dependencies=false —— peer 冲突仅告警不阻断（保持 npm 时代可装性）
auto-install-peers=true
strict-peer-dependencies=false

# 依赖外置：前端 node_modules 经 bms/scripts/tools/deps/ 脚本整体外置到本地依赖仓
# （见该脚本说明；store 内容寻址缓存默认全局 ~/.local/share/pnpm/store，不入项目）