{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js",
    "./deploy/tools/bg/bg.js"
  ],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "本地多模态（LM Studio）",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "id": "qwen/qwen3.6-35b-a3b",
          "name": "qwen3.6-35b-a3b 本地多模态",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "temperature": true
        }
      }
    }
  },
  "mcp": {
    "multimodal-local": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--project",
        "D:/Develop/bms/deploy/tools/multimodal",
        "python",
        "D:/Develop/bms/deploy/tools/multimodal/mcp_server.py"
      ],
      "enabled": true
    }
  }
}
