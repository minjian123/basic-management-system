{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "plugins/graphify.js",
    "plugins/bg.js"
  ],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "本地多模态（LM Studio）",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen3.8-27b": {
          "id": "qwen/qwen3.8-27b",
          "name": "qwen3.8-27b 本地多模态",
          "limit": {
            "context": 131072,
            "output": 131072
          },
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "mcp": {
    "multimodal-local": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--project",
        "D:/Develop/bms/scripts/tools/multimodal",
        "python",
        "D:/Develop/bms/scripts/tools/multimodal/mcp_server.py"
      ],
      "enabled": true
    }
  }
}
