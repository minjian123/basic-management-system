# BMS 后端环境变量模板：复制为 backend/.env 填实值（backend/.env 已 gitignore，不入库）
# 规则：环境变量优先级最高；嵌套键用双层下划线映射 config.toml 路径（BMS_<分区>__<键>）
# 密钥类只在此占位；基础设施凭据（库 root 口令、令牌等）只留 deploy/.env，两者不混

# ===== 环境选择（dev / test / prod） =====
BMS_ENV=dev

# ===== 应用 =====
BMS_APP__NAME=BMS 基础管理系统
# dev 覆盖为 true；test / prod 为 false
BMS_APP__DEBUG=true
# 雪花 ID WorkerId（0~1023，同环境多副本须全局唯一）
BMS_APP__WORKER_ID=0
# 服务标识（微服务名；用于按服务的连接池覆盖，缺省 platform）
BMS_APP__SERVICE=platform

# ===== 服务 =====
BMS_SERVER__HOST=0.0.0.0
BMS_SERVER__PORT=8000
BMS_SERVER__WORKERS=1

# ===== 日志（真实渲染随 03-2） =====
BMS_LOG__LEVEL=DEBUG
# console（dev）| json（test / prod）
BMS_LOG__FORMAT=console
BMS_LOG__SLOW_REQUEST_MS=1000

# ===== 健康检查（就绪探针超时，毫秒；见 03-3） =====
BMS_HEALTH__CHECK_TIMEOUT_MS=2000
BMS_HEALTH__TOTAL_TIMEOUT_MS=5000

# ===== 分页（见 01_04） =====
# 页码分页最大深度（超限按参数非法 10001；大数据量列表走 keyset 游标分页）
BMS_PAGINATION__MAX_PAGE=100

# ===== 多租户（解析链 / 引擎生命周期；见 01_02） =====
# 租户解析缓存 TTL（秒）：BMS_TENANT__RESOLVE_CACHE_TTL=60
# 租户引擎活跃上限：BMS_TENANT__ENGINE_MAX_ACTIVE=32
# 租户引擎闲置回收阈值（秒）：BMS_TENANT__ENGINE_IDLE_TIMEOUT=1800
# 无来源回落演示租户（生产置 false）：BMS_TENANT__ALLOW_DEMO_FALLBACK=true
# 豁免路径（JSON 数组）：BMS_TENANT__EXEMPT_PATHS=["/","/docs","/healthz"]

# ===== 数据库（平台 / 租户 / 归档；URL 不含密码，密码走 __PASSWORD 或完整 URL） =====
# SQLite 开发库自动建表（按迁移链表集；非 SQLite 环境自然跳过；生产置 false，建表统一走 Alembic 迁移）
BMS_DATABASE__AUTO_CREATE=true
# 平台库：BMS_DATABASE__PLATFORM__URL=mysql+aiomysql://bms_dev@<host>:3306/bms_dev
BMS_DATABASE__PLATFORM__PASSWORD=
# 只读副本（JSON 数组）：BMS_DATABASE__PLATFORM__REPLICAS=["mysql+aiomysql://..."]
# 连接池：BMS_DATABASE__PLATFORM__POOL__POOL_SIZE=5（另有 MAX_OVERFLOW / POOL_TIMEOUT / POOL_RECYCLE / CONNECT_TIMEOUT）
# 该库最大连接数（0 = 不校验连接预算）：BMS_DATABASE__PLATFORM__MAX_CONNECTIONS=0
# 按服务池覆盖（服务标识取 BMS_APP__SERVICE）：BMS_DATABASE__PLATFORM__SERVICES__PLATFORM__POOL__POOL_SIZE=5
# 租户库 / 归档库同构：BMS_DATABASE__TENANTS__URL / BMS_DATABASE__ARCHIVE__URL ...
# 租户库模板（占位 {service}/{tenant}/{database}）：BMS_DATABASE__TENANTS__URL_TEMPLATE=mysql+aiomysql://bms_dev@<host>:3306/{database}
BMS_DATABASE__TENANTS__PASSWORD=
BMS_DATABASE__ARCHIVE__PASSWORD=

# ===== Redis =====
# BMS_REDIS__URL=redis://<host>:6379/0

# ===== MinIO（占位，随文件管理阶段） =====
# BMS_MINIO__ENDPOINT=http://<host>:9000
BMS_MINIO__ACCESS_KEY=
BMS_MINIO__SECRET_KEY=
# BMS_MINIO__BUCKET=bms
# BMS_MINIO__SECURE=false

# ===== 安全（占位，随认证阶段） =====
BMS_SECURITY__SECRET_KEY=
# BMS_SECURITY__ALGORITHM=HS256
# BMS_SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== 跨域 =====
# BMS_CORS__ALLOW_ORIGINS=["http://localhost:5173"]
# BMS_CORS__ALLOW_METHODS=["*"]
# BMS_CORS__ALLOW_HEADERS=["*"]
# BMS_CORS__ALLOW_CREDENTIALS=true
