# ==================== BMS 环境变量样例 ====================
# 复制为 .env 后按需填写；本文件只给变量名与占位值，不填真实密钥。
# 全部环境变量带 BMS_ 前缀，UPPER_SNAKE，优先级高于 config.toml。

# 运行环境：dev / test / prod
BMS_ENV=dev

# 平台库连接串（生产必填；示例为 MySQL/PostgreSQL）
# BMS_DATABASE_PLATFORM_URL=mysql+aiomysql://bms:密码@主机:3306/bms_platform

# 租户库连接串模板（{code} 运行时替换为租户编码）
# BMS_DATABASE_TENANT_URL_TEMPLATE=mysql+aiomysql://bms:密码@主机:3306/bms_tenant_{code}

# Redis 连接串
# BMS_REDIS_URL=redis://主机:6379/0

# 日志级别
# BMS_LOG_LEVEL=INFO

# 雪花 ID 机器码（多实例时每实例唯一）
# BMS_SNOWFLAKE_WORKER_ID=0
